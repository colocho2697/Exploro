{
  "name": "exploro",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma inteligente de descubrimiento local y planificación de viajes basada en evidencias reales",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "infra:ps": "docker compose -f infrastructure/docker/docker-compose.yml ps"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}

