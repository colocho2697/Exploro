# =============================================================================
# EXPLORO — Variables de Entorno para Servidor de Producción (IP: 10.60.4.42)
# Configurado para coexistir sin conflictos de puertos con Watchman (8084, 9094) y Cliente (80).
# =============================================================================

NODE_ENV=production

# --- Frontend Web (Next.js) ---
# Expuesto en el puerto 3000 del host (http://10.60.4.42:3000)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://10.60.4.42:4000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyC-nH4VgbG66zwEXNme017vPrRh20Sa40U

# --- Backend Principal (NestJS API) ---
# Expuesto en el puerto 4000 del host (http://10.60.4.42:4000/api/v1)
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://10.60.4.42:3000,http://localhost:3000,http://10.60.4.42
JWT_SECRET=exploro_prod_jwt_super_secret_key_2026_min_32_chars
JWT_ACCESS_SECRET=exploro_prod_jwt_access_secret_2026_min_32_chars
JWT_REFRESH_SECRET=exploro_prod_jwt_refresh_secret_2026_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
GOOGLE_PLACES_API_KEY=AIzaSyC-nH4VgbG66zwEXNme017vPrRh20Sa40U

# --- Base de Datos Principal (PostgreSQL 16 + PostGIS 3.4 en Docker) ---
POSTGRES_USER=exploro_prod
POSTGRES_PASSWORD=exploro_prod_secure_password_2026
POSTGRES_DB=exploro_prod_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://exploro_prod:exploro_prod_secure_password_2026@postgres:5432/exploro_prod_db?schema=public

# --- Redis (Caché, Sesiones y Rate Limiting) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Almacenamiento S3 Local Sin Costo (MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=exploro_s3_admin_user
S3_SECRET_KEY=exploro_s3_super_secret_key_2026
S3_BUCKET_MEDIA=exploro-media
S3_REGION=us-east-1

# --- Microservicio de IA (Python + FastAPI) ---
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://ai-engine:8000
INTERNAL_SERVICE_KEY=exploro_internal_ai_service_key_2026
AI_PROVIDER=ollama
LOCAL_OLLAMA_URL=http://host.docker.internal:11434
AI_DEFAULT_MODEL=qwen2.5:7b

# --- Proveedor Geográfico Open Source ($0.00) ---
GEO_PROVIDER=osm_free
MAP_TILES_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# --- Clientes Móviles (Expo Go / App Nativa) ---
# Los teléfonos conectados a la red apuntarán a la IP del servidor:
EXPO_PUBLIC_API_URL=http://10.60.4.42:4000/api/v1
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
