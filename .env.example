# =============================================================================
# EXPLORO — Variables de Entorno (Plantilla de Ejemplo - Costo Cero $0.00)
# Copiar a .env para desarrollo local. Nunca subir secretos reales a Git.
# =============================================================================

NODE_ENV=development

# --- Base de Datos Principal (PostgreSQL 16 + PostGIS 3.4 en Docker) ---
POSTGRES_USER=exploro
POSTGRES_PASSWORD=exploro_dev_local_pass
POSTGRES_DB=exploro_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://exploro:exploro_dev_local_pass@localhost:5432/exploro_db?schema=public

# --- Redis (Caché, Sesiones, Rate Limiting y Colas BullMQ en Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Almacenamiento S3 Local Sin Costo (MinIO en Docker) ---
S3_ENDPOINT=http://localhost:9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=exploro_minio_admin
S3_SECRET_KEY=exploro_minio_secret_key
S3_BUCKET_MEDIA=exploro-media
S3_REGION=us-east-1

# --- Backend Principal (NestJS API) ---
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- Microservicio de IA en Docker (Python + FastAPI + Ollama Costo $0) ---
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=dev_internal_service_key_exploro_ai_2026
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_DEFAULT_MODEL=qwen2.5:7b

# --- Proveedor Geográfico Open Source Costo $0 (MapLibre + OSM + Nominatim + OSRM) ---
GEO_PROVIDER=osm_free
MAP_TILES_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# --- Feature Flags Iniciales (Fase 1 y Fase 6) ---
FEATURE_LOCAL_MODE_ENABLED=false
FEATURE_TRIP_PLANNER_ENABLED=false

# --- Clientes Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

