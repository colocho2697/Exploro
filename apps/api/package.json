{
  "name": "@exploro/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fileParallelism=false",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@exploro/business-rules": "workspace:*",
    "@exploro/shared-types": "workspace:*",
    "@exploro/validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "ioredis": "^5.5.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@exploro/api-client": "workspace:*",
    "@exploro/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
